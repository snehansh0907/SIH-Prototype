# Server
PORT=5000

# Supabase
# Get these from your Supabase project: Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Open-Meteo (no API key required, base URL only)
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# Frontend (used for CORS)
FRONTEND_URL=http://localhost:5173

# Pluggable Crop Disease ML API (Optional: leave empty to use built-in engine)
CROP_DISEASE_API_URL=
CROP_DISEASE_API_KEY=

# Optional Server-Side LLM for Agronomist Consultation (Never exposed to client)
ANTHROPIC_API_KEY=

