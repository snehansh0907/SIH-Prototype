# =========================================================
# Pashu Sarthak Backend Environment Configuration (SIH26128)
# =========================================================

# Server Port (Default: 5001 or 5000)
PORT=5001

# Supabase Credentials (Database & Storage)
# Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-optional

# Open-Meteo Weather Service (No API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# Frontend Origin for CORS Allowed Origins
FRONTEND_URL=http://localhost:5173

# Optional Pluggable Livestock Pathology Vision Model Endpoint
LIVESTOCK_DISEASE_API_URL=
LIVESTOCK_DISEASE_API_KEY=

# Optional Server-Side LLM for AI Veterinary Assistant
ANTHROPIC_API_KEY=
