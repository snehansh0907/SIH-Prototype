# =========================================================
# Pashu Sarthak Frontend Environment Configuration (SIH26128)
# =========================================================

# Backend API Endpoint connecting to Node.js / Express backend
# Development: http://localhost:5001/api
# Production: https://pashu-sarthak-api.onrender.com/api
VITE_API_URL=http://localhost:5001/api

# Demo Mode: 'false' for live backend & Supabase, 'true' for offline deterministic demo
VITE_DEMO_MODE=false

# Supabase Client Configuration (Optional: fallback built-in)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
